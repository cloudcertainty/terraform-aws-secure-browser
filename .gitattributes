# Line endings: LF in the repository and in every checkout, whatever core.autocrlf says
# (Terraform, terraform fmt, terraform-docs and the CI shell steps expect LF).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
